{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "server.js" },
    { "source": "/webhook/(.*)", "destination": "server.js" },
    { "source": "/webhook-macro/(.*)", "destination": "server.js" },
    { "source": "/((?!api/|webhook/|webhook-macro/).*)", "destination": "/index.html" }
  ]
}